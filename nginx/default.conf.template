server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        # proxy_pass with the env-substituted URL as a LITERAL (no nginx variable)
        # so nginx resolves the API host once at startup via the container's normal
        # OS resolver (/etc/resolv.conf). Avoids the `resolver` directive, whose
        # hardcoded Azure DNS (168.63.129.16) is unreachable inside Container Apps.
        # No URI on proxy_pass: the original request path (/api/...) is forwarded as-is.
        proxy_pass ${API_URL};
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host ${API_HOST};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
